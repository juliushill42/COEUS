FROM rust:1.79-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY scheduler/Cargo.toml scheduler/
COPY telemetry/Cargo.toml telemetry/
RUN mkdir -p scheduler/src telemetry/src && \
    echo "fn main(){}" > scheduler/src/main.rs && \
    echo "fn main(){}" > telemetry/src/main.rs && \
    cargo build --release --package coeus-telemetry 2>/dev/null || true

COPY telemetry/src telemetry/src/
RUN touch telemetry/src/main.rs && cargo build --release --package coeus-telemetry

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/coeus-telemetry /usr/local/bin/coeus-telemetry
ENV COEUS_TELEMETRY_PORT=8081
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/coeus-telemetry"]
